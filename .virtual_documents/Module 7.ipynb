### Allow selection only along axis
brush2 = alt.selection_interval(encodings=['x'])


scatter = alt.Chart(movies).mark_circle().encode(
    y = alt.Y('IMDB_Votes'),
    color=alt.condition(brush2, 'Major_Genre', alt.value('lightgray')),
    opacity = alt.condition(brush2, alt.value(1), alt.value(0.05))
).add_selection(brush2)

scatter.encode(x='Production_Budget') | scatter.encode(x='US_Gross')

























scatter2 = alt.Chart(movies).mark_circle().encode(
    x = alt.X("Production_Budget"),
    y = alt.Y("IMDB_Votes"),
    color = 'Major_Genre'
)


scatter2


select_genre = alt.selection_multi(fields=['Major_Genre'], bind="legend")

bar = alt.Chart(movies).mark_bar().encode(
    x = 'Major_Genre',
    y = "mean(IMDB_Votes)",
    color="Major_Genre",
    opacity = alt.condition(select_genre, alt.value(1), alt.value(0.1))
).add_selection(select_genre)

bar

