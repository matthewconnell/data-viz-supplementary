### Do more recent movies have higher ratings than movies from the 1970's?

movies['Release_Date'] = pd.to_datetime(movies['Release_Date'])
movies['Release_Year'] = movies['Release_Date'].dt.year
movies2 = movies[movies['Release_Date'].dt.year <= 2011]


movies2.tail(5)


interval_brush = alt.selection_interval(encodings=['x'])

rating_scatter = alt.Chart(movies2).mark_circle().encode(
    x = 'IMDB_Votes',
    y = 'IMDB_Rating',
    opacity = alt.condition(interval_brush, 'Major_Genre', alt.value(0.01)),
    color = 'Major_Genre'
).add_selection(interval_brush)

bar_plot = alt.Chart(movies2).mark_bar().encode(
    x = 'Release_Year',
    y = 'count()',
    color = alt.condition(interval_brush, alt.value('blue'), alt.value('gray'))
).add_selection(interval_brush).properties(height=50)

rating_scatter & bar_plot


s = alt.selection_single()

rating_scatter = alt.Chart(movies2).mark_circle().encode(
    x = 'IMDB_Votes',
    y = 'IMDB_Rating',
    color = alt.condition(s, alt.value('blue'), alt.value('gray'))
).add_selection(s)

bar_plot = alt.Chart(movies2).mark_bar().encode(
    x = 'Release_Year',
    y = 'count()',
    color = alt.condition(s, alt.value('blue'), alt.value('gray'))
).add_selection(s).properties(width=800)

(rating_scatter & bar_plot).add_selection(s)


